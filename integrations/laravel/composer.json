{
  "name": "gnomon/gnomon",
  "description": "Branches of a PostgreSQL database with gnomon, from PDO and Laravel; a PHPUnit and Pest trait with a scratch branch per test",
  "type": "library",
  "license": "PostgreSQL",
  "homepage": "https://github.com/bitsinfra/gnomon",
  "support": {
    "issues": "https://github.com/bitsinfra/gnomon/issues",
    "source": "https://github.com/bitsinfra/gnomon"
  },
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "orchestra/testbench": "^10.0 || ^11.0"
  },
  "suggest": {
    "illuminate/database": "the Laravel connection resolver, middleware and test trait (Laravel 10 or later)"
  },
  "autoload": {
    "psr-4": {
      "Gnomon\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gnomon\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Gnomon\\Laravel\\GnomonServiceProvider"
      ]
    }
  }
}
